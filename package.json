{
  "name": "marvel-watch-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "A sleek, modern Marvel Cinematic Universe watch order and progress tracker built with React and Electron.",
  "author": "Marvel Watch Tracker",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "electron": "npm run build && electron .",
    "app": "electron .",
    "dist": "npm run build && electron-builder",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-android.ps1",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.marvel.watchtracker",
    "productName": "Marvel Watch Tracker",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}
