rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User-specific watch progress document
    match /users/{userId}/watchProgress/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default watch tracker collection
    match /marvel_tracker/{docId} {
      allow read, write: if true;
    }
  }
}
